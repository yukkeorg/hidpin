# hidpin: allow the logged-in user to open the device without root.
#
# Install:
#   sudo cp udev/60-hidpin.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   (then unplug and replug the board)
#
# Two rules, because there are two ways to reach a HID device on Linux:
#   - hidraw: opens /dev/hidrawN         -> first rule; this is what host/ uses
#   - libusb: opens /dev/bus/usb/BBB/DDD -> second rule; used by the hidapi wheels
#     on PyPI (HIDPIN_BACKEND=hidapi) and by other libusb-based tools.
#
# 1209:6870 is allocated to hidpin by pid.codes (https://pid.codes/1209/6870/).
# A firmware built with other ids (HIDPIN_USB_VID / HIDPIN_USB_PID) needs lines of its own.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="6870", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="6870", TAG+="uaccess", MODE="0660", GROUP="plugdev"
